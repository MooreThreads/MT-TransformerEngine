#ifndef TRANSFORMER_ENGINE_MUSA_COMMON_UTIL_MTFP8_GROUPWISE_QUANTIZE_MUH_
#define TRANSFORMER_ENGINE_MUSA_COMMON_UTIL_MTFP8_GROUPWISE_QUANTIZE_MUH_

#include "../common.h"
#include "../utils.muh"
#include "math.h"
#include "mtfp8_utils.muh"

#include "transformer_engine/transformer_engine.h"

namespace transformer_engine::mtfp8 {

template <
    typename Param,
    float (*OP)(float, const Param &),
    typename IType,
    typename OType,
    typename CType,
    size_t VLEN>
__global__ void fp8_groupwise_1_to_n_kernel(
    const IType* inp,
    const CType* noop,
    OType* out,
    CType* sinv,
    size_t M,
    size_t N,
    size_t group_size,
    Param param) {
  if (noop != nullptr && noop[0] == 1.0f) return;
  using IVecT = Vec<IType, VLEN>;
  using CVecT = Vec<CType, VLEN>;
  using OVecT = Vec<OType, VLEN>;

  extern __shared__ __align__(alignof(CType)) char temp[];
  const size_t tid = threadIdx.x;
  const size_t wrap_id = tid / wrap_size;
  const size_t lane_id = tid % wrap_size;

  const size_t groups_per_channel = N / group_size;
  constexpr size_t elems_per_col = wrap_size * VLEN;
  const size_t groups_per_col = elems_per_col / group_size;
  const size_t groups_per_row = blockDim.x / wrap_size;

  auto* temp_base = reinterpret_cast<CVecT*>(temp);

  const size_t dimx = blockIdx.x * groups_per_row + wrap_id;
  const size_t sub_offset_y = lane_id * VLEN;
  const size_t dimy = blockIdx.y * elems_per_col + sub_offset_y;

  const size_t offset = dimx * N + dimy;
  size_t amax_idx = sub_offset_y / group_size;

  IVecT vec_in;
  CVecT& tran = *(temp_base + tid);
  CType amax = 0;
  const bool valid = (dimx < M && dimy < N);
  if (valid) {
    vec_in.load_from(inp + offset, 0);
#pragma unroll
    for (size_t j = 0; j < VLEN; ++j) {
      tran.data.elt[j] = (CType)(OP((float)vec_in.data.elt[j], param));
      amax = fmaxf(fabsf(tran.data.elt[j]), amax);
      amax = fmaxf(amax, global_amax_min);
    }
  }

  for (size_t i = 0; i < groups_per_col; ++i) {
    const bool flag = (i == amax_idx);
    CType group_max = flag ? amax : 0;
    group_max = warp_reduce_max_broadcast(group_max);
    if (flag) {
      amax = group_max;
    }
  }

  OVecT vec_out;
  CType scale = (CType)(Quantized_Limits<OType>::max_norm) / amax;
  if (valid) {
#pragma unroll
    for (size_t j = 0; j < VLEN; ++j) {
      vec_out.data.elt[j] = (OType)(tran.data.elt[j] * scale);
    }
    vec_out.store_to(out + offset, 0);
  }

  if (valid && (sub_offset_y % group_size == 0)) {
    const size_t sinv_offset = dimx * groups_per_channel + dimy / group_size;
    *(sinv + sinv_offset) = amax * (CType)(Quantized_Limits<OType>::max_norm_rcp);
  }
}

template <
    typename Param,
    float (*OP)(float, const Param &),
    typename IType,
    typename OType,
    typename CType>
inline void fp8_groupwise_cast(
    const IType* inp,
    const CType* noop,
    OType* out,
    CType* sinv,
    size_t M,
    size_t N,
    size_t group_size,
    Param param,
    musaStream_t stream) {
  NVTE_CHECK(N % group_size == 0);

  constexpr size_t VLEN = io_bytes / sizeof(IType);
  constexpr size_t elems_per_wrap = VLEN * wrap_size;

  if (elems_per_wrap < group_size) {
    NVTE_ERROR("Not supported [1, ", group_size, "] blocksize for mtfp8 groupwise quantize.");
  } else {
    if (elems_per_wrap % group_size != 0) {
      NVTE_ERROR("Not supported [1, ", group_size, "] blocksize for mtfp8 groupwise quantize.");
    }

    const size_t thd_x = 8;
    const size_t thd_y = wrap_size;
    const size_t threads = thd_x * thd_y;

    const int blk_x = ceil_div(M, thd_x);
    const int blk_y = ceil_div(N, elems_per_wrap);
    dim3 blocks(blk_x, blk_y);

    const size_t shm_trans = threads * VLEN * sizeof(CType);
  
    fp8_groupwise_1_to_n_kernel<Param, OP, IType, OType, CType, VLEN>
        <<<blocks, (int)threads, shm_trans, stream>>>(
          inp, noop, out, sinv, M, N, group_size, param);

    NVTE_CHECK_CUDA(musaGetLastError());
  }
}

} // namespace transformer_engine::mtfp8

#endif // TRANSFORMER_ENGINE_MUSA_COMMON_UTIL_MTFP8_GROUPWISE_QUANTIZE_MUH_
