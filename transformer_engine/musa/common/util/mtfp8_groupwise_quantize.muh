/*
template <typename Param, float (*OP)(float, const Param &),
          typename IType, typename CType, size_t VLEN,
          size_t Rounds, bool AlignTail>
inline __device__ void fp8_load_trans_max(
    const IType* start,
    const IType* end,
    size_t stride,
    Vec<CType, VLEN> vec_trans[Rounds],
    Param param,
    CType& amax) {
  constexpr size_t AlignRounds = AlignTail ? Rounds : Rounds - 1;
  Vec<IType, VLEN> vec_in;

#pragma unroll
  for (size_t i = 0; i < AlignRounds; ++i) {
    vec_in.load_from(start, 0);
#pragma unroll
    for (size_t j = 0; j < VLEN; ++j) {
      vec_trans[i].data.elt[j] = (CType)(OP((float)vec_in.data.elt[j], param));
      __builtin_assume(amax >= 0);
      amax = fmaxf(fabsf(vec_trans[i].data.elt[j]), amax);
    }
    start += stride;
  }

  if constexpr (!AlignTail) {
#pragma unroll
    for (size_t j = 0; j < VLEN; ++j) {
      if (start < end) {
        vec_trans[AlignRounds].data.elt[j] = (CType)(OP((float)(*start), param));
        __builtin_assume(amax >= 0);
        amax = fmaxf(fabsf(vec_trans[AlignRounds].data.elt[j]), amax);
        ++start;
      }
    }
  }
}

template <typename OType, typename CType, size_t VLEN,
          size_t Rounds, bool AlignTail>
inline __device__ void fp8_cast_store(
    OType* start,
    OType* end,
    size_t stride,
    Vec<CType, VLEN> vec_trans[Rounds],
    CType scale) {
  constexpr size_t AlignRounds = AlignTail ? Rounds : Rounds - 1;
  Vec<OType, VLEN> vec_out;

#pragma unroll
  for (size_t i = 0; i < AlignRounds; ++i) {
#pragma unroll
    for (size_t j = 0; j < VLEN; ++j) {
      vec_out.data.elt[j] = (OType)(vec_trans[i].data.elt[j] * scale);
    }
    vec_out.store_to(start, 0);
    start += stride;
  }

  if constexpr (!AlignTail) {
#pragma unroll
    for (size_t j = 0; j < VLEN; ++j) {
      if (start < end) {
        *start = (OType)(vec_trans[AlignRounds].data.elt[j] * scale);
        ++start;
      }
    }
  }
}

template <
    typename Param,
    float (*OP)(float, const Param &),
    typename IType,
    typename OType,
    typename CType,
    size_t VLEN,
    size_t AlignRounds,
    bool AlignTail>
__global__ void fp8_groupwise_1_to_1_kernel(
    const IType* inp,
    const CType* noop,
    OType* out,
    CType* sinv,
    size_t group_size,
    Param param) {
  if (noop != nullptr && noop[0] == 1.0f) return;
  using CVecT = Vec<CType, VLEN>;

  constexpr size_t Rounds = AlignTail ? AlignRounds : AlignRounds + 1;
  CVecT temp[Rounds];
  CType amax = 0;

  const size_t tid = threadIdx.x;
  const size_t group_id = blockIdx.x;
  const size_t lane_id = tid % wrap_size;

  const size_t offset = group_size * group_id;
  const size_t sub_offset = lane_id * VLEN;
  const size_t stride = wrap_size * VLEN;

  const IType* in_addr = inp + offset;
  OType* out_addr = out + offset;
  CType* sinv_addr = sinv + group_id;

  fp8_load_trans_max<Param, OP, IType, CType, VLEN, Rounds, AlignTail>(
      in_addr + sub_offset, in_addr + group_size, stride, temp, param, amax);

  amax = warp_reduce_max_broadcast(amax);

  CType scale = (CType)(Quantized_Limits<OType>::max_norm) / amax;
  fp8_cast_store<OType, CType, VLEN, Rounds, AlignTail>(
      out_addr + sub_offset, out_addr + group_size, stride, temp, scale);

  if (lane_id == 0) {
    *sinv_addr = amax * (CType)(Quantized_Limits<OType>::max_norm_rcp);
  }
}

